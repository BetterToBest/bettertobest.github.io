    {
      "@type": "ScholarlyArticle",
      "name": "The Basic Living Economic Index (BLEI): A Temporal Stability Framework for Post-Scarcity Economic System Evaluation",
      "url": "https://bettertobest.github.io/research-hub/basic-living-economic-index.html",
      "datePublished": "2026-05-25",
      "dateModified": "2026-05-25",
      "author": [
        {"@type": "Person", "name": "Duke Johnson", "@id": "https://independentresearcher.academia.edu/DukeJohnson"},
        {"@type": "Organization", "name": "Anthropic Claude", "description": "AI Research Assistant"}
      ],
      "keywords": [
        "Basic Living Economic Index",
        "Temporal Stability",
        "Extractive Drain Coefficient",
        "Effective Purchasing Power Multiplier",
        "Financial Bandwidth Score",
        "Compound Stability Index",
        "Indirect Participant Benefit Index",
        "Post-Scarcity Economics",
        "Creative Currency Octaves",
        "Public Trust Housing",
        "Community Land Trusts",
        "Alaska Permanent Fund",
        "Mondragon",
        "Agent-Based Modeling",
        "Dual Currency Systems",
        "Universal Basic Services",
        "Welfare Measurement"
      ],
      "abstract": "Introduces a unified temporal stability framework for welfare measurement in dual-currency and community ownership economic systems. Six complementary indices — BLEI, EDC, EPPM, FBS, CSI, IPBI — correct three structural gaps in conventional welfare metrics: extraction-accumulation asymmetry, purchasing power premium of community-priced essential goods, and temporal stability governing multi-year entrepreneurial investment feasibility. Applied to US household profiles under CCO-PTF conditions, the framework reveals welfare divergence substantially larger than Gini-based comparisons suggest. Near-poverty households achieve Flourishing-tier stability (730+ days) at approximately 33 months.",
      "about": [
        {"@type": "Thing", "name": "Basic Living Economic Index", "additionalType": "WelfareMeasurementFramework"},
        {"@type": "Thing", "name": "Creative Currency Octaves", "additionalType": "EconomicEngine"},
        {"@type": "Thing", "name": "Public Trust Foundations", "additionalType": "CommunityAssetLayer"},
        {"@type": "Thing", "name": "Public Trust Housing", "additionalType": "CommunityAssetLayer"}
      ],
      "encoding": {
        "@type": "MediaObject",
        "encodingFormat": "application/pdf",
        "contentUrl": "https://bettertobest.github.io/research-hub/papers/pdfs/basic-living-economic-index.pdf"
      }
    },
